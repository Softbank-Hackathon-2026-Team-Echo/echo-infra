#!/usr/bin/env bash
# 시험용 kubectl: `kubectl --context <ctx> -n <ns> exec -i <대상> [-c <컨테이너>] -- <명령…>` 만 받는다.
# - echo-pg-0 → docker exec echo-t-pg-{a,b} (PgBouncer 관리 콘솔 명령 `-d pgbouncer` 은 $STATE/pgb.log 에 적고 성공)
# - deploy/echo-pgbouncer → /etc/pgbouncer/pgbouncer.ini 를 $STATE/pgb_{A,B}.ini 로 바꿔 이 컴퓨터에서 실행
# FAIL_SQL(정규식)에 맞는 인자가 있으면 실패해 스크립트의 실패 처리(guard_on_error)를 시험한다.
set -euo pipefail
export MSYS_NO_PATHCONV=1
# ConfigMap echo-pgbouncer-ini 는 $STATE/cm_{A,B}.ini 로 대신한다(get = 읽기, patch = data.pgbouncer.ini 바꾸기).
all=" $* "
if [[ $all == *" get configmap echo-pgbouncer-ini "* || $all == *" patch configmap echo-pgbouncer-ini "* ]]; then
  c=; p=; prev=
  for a in "$@"; do [[ $prev == --context ]] && c=$a; [[ $prev == -p ]] && p=$a; prev=$a; done
  [[ $c == "$A_CTX" ]] && s=A || s=B
  if [[ $all == *" get "* ]]; then cat "$STATE/cm_$s.ini"; exit 0; fi
  # FAIL_CM=<A|B>: 그쪽 ConfigMap 쓰기(patch)만 실패시킨다
  if [[ -n ${FAIL_CM:-} && $s == "$FAIL_CM" ]]; then echo "[fake kubectl] FAIL_CM 로 실패: $s" >&2; exit 1; fi
  python -I -c 'import json,sys; sys.stdout.buffer.write(json.loads(sys.argv[1])["data"]["pgbouncer.ini"].encode())' "$p" > "$STATE/cm_$s.ini"
  echo "$s" >> "$STATE/cm.log"; exit 0
fi
# 풀 방식(POOL_SIDES 에 든 쪽, 예 "A B"): 표지판 echo-data/db-writer 는 $STATE/dw_sel_{A,B}(selector app 값, 비면 없음)
# 와 $STATE/dw_host_{A,B}(EndpointSlice db-writer-manual 의 echo/writer-host, 파일이 없으면 슬라이스 없음)로 대신한다.
# echo-pool 의 admin 사이드카 psql(-d pgbouncer)은 옛 방식처럼 $STATE/pgb.log 에 적고 성공.
if [[ $all == *" db-writer"* || $all == *" -n echo-pool "* || $all == *" endpointslice "* || $all == *" apply -f - "* || $all == *" get deploy echo-pgbouncer "* ]]; then
  c=; prev=; for a in "$@"; do [[ $prev == --context ]] && c=$a; prev=$a; done
  [[ $c == "$A_CTX" ]] && s=A || s=B
  [[ " ${POOL_SIDES:-} " == *" $s "* ]] || exit 1                          # 이 쪽은 옛 방식: 표지판 없음
  case $all in
    *" get svc db-writer -o name "*) echo service/db-writer ;;
    *" get svc db-writer "*selector.app*) cat "$STATE/dw_sel_$s" 2>/dev/null || true ;;
    *" patch svc db-writer "*'"selector":null'*) : > "$STATE/dw_sel_$s" ;;
    *" patch svc db-writer "*'"app":"echo-pg"'*) echo echo-pg > "$STATE/dw_sel_$s" ;;
    *" get endpointslice db-writer-manual "*) [[ -f $STATE/dw_host_$s ]] || exit 1; cat "$STATE/dw_host_$s" ;;
    *" delete endpointslice db-writer-manual "*) rm -f "$STATE/dw_host_$s" ;;
    *" delete endpointslice "*"managed-by!=echo-cutover"*) : ;;   # 컨트롤러·미러링 슬라이스 지우기(상태 파일에는 없음)
    *" delete endpoints db-writer "*) : ;;
    *" get deploy echo-pgbouncer "*) exit 1 ;;                                  # 풀 방식 쪽은 옛 Deployment 를 지운 뒤(4단계)
    *" apply -f - "*) sed -n 's/.*echo\/writer-host: "\([^"]*\)".*/\1/p' > "$STATE/dw_host_$s"; echo "$s" >> "$STATE/dw.log" ;;
    *" exec -i deploy/echo-pgbouncer -c admin "*" -d pgbouncer "*) echo "$s ${*: -1}" >> "$STATE/pgb.log" ;;
    *) echo "[fake kubectl] 풀 방식에서 모르는 명령: $*" >&2; exit 1 ;;
  esac
  exit 0
fi
ctx= target=
while [[ $# -gt 0 ]]; do
  case $1 in
    --context) ctx=$2; shift 2 ;;
    -n|-c) shift 2 ;;
    exec|-i|--request-timeout=*) shift ;;
    --) shift; break ;;
    *) target=$1; shift ;;
  esac
done
[[ $ctx == "$A_CTX" ]] && side=A || side=B
cmd=("$@")
# SLOW_SQL(정규식)에 맞는 인자가 있으면 SLOW_SEC(기본 6)초 기다린 뒤 실행한다(신호 처리 시험용).
if [[ -n ${SLOW_SQL:-} ]]; then
  for a in "${cmd[@]}"; do [[ $a =~ $SLOW_SQL ]] && { sleep "${SLOW_SEC:-6}"; break; }; done
fi
if [[ -n ${FAIL_SQL:-} ]]; then
  for a in "${cmd[@]}"; do [[ $a =~ $FAIL_SQL ]] && { echo "[fake kubectl] FAIL_SQL 로 실패: $FAIL_SQL" >&2; exit 1; }; done
fi
case $target in
  echo-pg-0)
    if [[ " ${cmd[*]} " == *" -d pgbouncer "* ]]; then echo "$side ${cmd[${#cmd[@]}-1]}" >> "$STATE/pgb.log"; exit 0; fi   # ${cmd[-1]} 은 macOS bash 3.2 에 없다
    for i in "${!cmd[@]}"; do cmd[$i]=${cmd[$i]//sslmode=require/sslmode=disable}; done
    [[ $side == A ]] && c=${T_PREFIX:-echo-t}-pg-a || c=${T_PREFIX:-echo-t}-pg-b
    exec docker exec -i -e REPL_PASSWORD=test -e PGB_AUTH_PASSWORD=test "$c" "${cmd[@]}" ;;
  deploy/echo-pgbouncer)
    for i in "${!cmd[@]}"; do cmd[$i]=${cmd[$i]//\/etc\/pgbouncer\/pgbouncer.ini/$STATE/pgb_$side.ini}; done
    exec "${cmd[@]}" ;;
  *) echo "[fake kubectl] 모르는 대상: $target" >&2; exit 1 ;;
esac
