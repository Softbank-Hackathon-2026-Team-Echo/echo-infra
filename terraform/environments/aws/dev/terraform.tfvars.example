# 복사해서 terraform.tfvars 로 쓴다 (terraform.tfvars 는 커밋하지 않는다).
eks_admin_principal_arns = [
  "arn:aws:iam::<account_id>:user/<이름>",
]

# 장소 IP 가 정해지면 좁힌다
# eks_public_access_cidrs = ["203.0.113.0/24"]

# 필수. GCP 루트 출력값 control_plane_service_account_unique_id (echo-was 관제탑 GSA 의 숫자 ID)
executor_google_service_account_id = "<uniqueId>"

budget_limit_usd           = 150
budget_notification_emails = ["<팀 메일>"]

# ALB 컨트롤러 권한 이름 (lbc.tf). 기존 dev 는 "echo-was-lbc"/"echo-was-lbc-policy", 새 환경은 비워 둔다
# lbc_role_name   = ""
# lbc_policy_name = ""

# 선택. GCP 루트 출력값 cutover_service_account_unique_id (컷오버 Job GSA 의 숫자 ID). 비우면 cutover 역할을 만들지 않는다
# cutover_google_service_account_id = "<uniqueId>"

# 선택. 인프라 17 진입점 c (AWS 서울). 순서는 specs/infra-17-second-provider-entrypoint.md 7절 — 토큰 SSM 파라미터를 먼저 넣는다
# entrypoint_c_enabled   = true
# entrypoint_c_upstreams = { aws = "<닻 ALB DNS>:80", gcp = "<ingress-nginx-entry-c EXTERNAL-IP>:80" }
# entrypoint_c_sync_from = "http://<GCP 출력 entrypoint_ip>:8080"
