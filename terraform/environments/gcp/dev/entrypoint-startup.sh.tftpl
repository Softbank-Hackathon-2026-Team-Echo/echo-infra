#!/usr/bin/env bash
# 고정 진입점 VM startup 스크립트 (Terraform templatefile). 부팅마다 돈다. 멱등.
set -euo pipefail
ROOT=/opt/entrypoint
export DEBIAN_FRONTEND=noninteractive

log() { echo "[entrypoint-startup] $*"; }

# 1. Docker (공식 저장소) + compose 플러그인
if ! command -v docker >/dev/null 2>&1; then
  log "docker 설치"
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg >/dev/null
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-compose-plugin >/dev/null
  systemctl enable --now docker
fi

# 2. 설정 파일 (entrypoint/ 디렉터리 그대로)
mkdir -p "$ROOT"
%{ for p, c in files ~}
mkdir -p "$(dirname "$ROOT/${p}")"
cat > "$ROOT/${p}" <<'ECHO_ENTRY_FILE_EOF'
${c}
ECHO_ENTRY_FILE_EOF
%{ endfor ~}

# 3. 비밀값: 첫 부팅 때만 만들고 Secret Manager 에 넣는다 (VM 서비스 계정, REST + 메타데이터 토큰).
add_secret_version() { # $1=secret id, $2=값
  local token
  token=$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')
  curl -sf -X POST -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -d "{\"payload\":{\"data\":\"$(printf '%s' "$2" | base64 -w0)\"}}" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$1:addVersion" >/dev/null \
    && log "secret $1 에 version 추가" || log "경고: secret $1 version 추가 실패 (권한·API 확인)"
}

# 진입점이 두 곳이면 같은 토큰·비밀번호를 써야 하므로, Secret Manager 에 이미 값이 있으면 그걸 읽는다(없을 때만 새로 만든다).
read_secret_latest() { # $1=secret id → stdout 값 (없거나 권한 없으면 빈 문자열)
  local token
  token=$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')
  curl -sf -H "Authorization: Bearer $token" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$1/versions/latest:access" \
    | python3 -c 'import sys,json,base64; print(base64.b64decode(json.load(sys.stdin)["payload"]["data"]).decode())' 2>/dev/null || true
}

if [ ! -f "$ROOT/.env.secrets" ]; then
  WEIGHTS_TOKEN=$(read_secret_latest "${secret_token}")
  GRAFANA_ADMIN_PASSWORD=$(read_secret_latest "${secret_grafana}")
  if [ -n "$WEIGHTS_TOKEN" ]; then log "토큰: Secret Manager 의 기존 값 사용 (진입점 두 곳 공유)"; else log "토큰 생성"; WEIGHTS_TOKEN=$(openssl rand -hex 32); fi
  if [ -n "$GRAFANA_ADMIN_PASSWORD" ]; then log "Grafana 비밀번호: Secret Manager 의 기존 값 사용"; else log "Grafana 비밀번호 생성"; GRAFANA_ADMIN_PASSWORD=$(openssl rand -hex 16); fi
  umask 077
  printf 'WEIGHTS_TOKEN=%s\nGRAFANA_ADMIN_PASSWORD=%s\n' "$WEIGHTS_TOKEN" "$GRAFANA_ADMIN_PASSWORD" > "$ROOT/.env.secrets"
  umask 022
  [ -z "$(read_secret_latest "${secret_token}")" ] && add_secret_version "${secret_token}" "$WEIGHTS_TOKEN"
  [ -z "$(read_secret_latest "${secret_grafana}")" ] && add_secret_version "${secret_grafana}" "$GRAFANA_ADMIN_PASSWORD"
fi

# 3-b. Prometheus remote write 수신 + basic auth (인프라 9). 이미 켜진 VM 은 .env.secrets 가 있어 위 블록을 건너뛰므로 따로 맞춘다.
# 비밀번호 원문은 Secret Manager·.env(0600)에만, Prometheus 설정 파일에는 bcrypt 해시만 쓴다.
PROM_ENV="PROMETHEUS_REMOTE_WRITE_FLAG=no-web.enable-remote-write-receiver"
if [ "${prom_rw_enabled}" = "true" ]; then
  if ! grep -q '^PROMETHEUS_RW_PASSWORD=' "$ROOT/.env.secrets"; then
    PROMETHEUS_RW_PASSWORD=$(read_secret_latest "${secret_prom_rw}")
    if [ -n "$PROMETHEUS_RW_PASSWORD" ]; then log "remote write 비밀번호: Secret Manager 의 기존 값 사용"; else
      log "remote write 비밀번호 생성"; PROMETHEUS_RW_PASSWORD=$(openssl rand -hex 24)
      add_secret_version "${secret_prom_rw}" "$PROMETHEUS_RW_PASSWORD"
    fi
    umask 077
    printf 'PROMETHEUS_RW_PASSWORD=%s\n' "$PROMETHEUS_RW_PASSWORD" >> "$ROOT/.env.secrets"
    umask 022
  fi
  # bcrypt 해시용 htpasswd. 패키지 목록이 오래됐을 수 있어 update 를 먼저 한다(처음 켤 때 한 번만)
  command -v htpasswd >/dev/null 2>&1 || { apt-get update -qq && apt-get install -y -qq apache2-utils >/dev/null; }
  PROMETHEUS_RW_PASSWORD=$(sed -n 's/^PROMETHEUS_RW_PASSWORD=//p' "$ROOT/.env.secrets")
  printf '%s' "$PROMETHEUS_RW_PASSWORD" | bash "$ROOT/scripts/render-prometheus-web.sh" "$ROOT/prometheus-web.yml" echo-otel
  PROM_ENV=$(printf 'PROMETHEUS_REMOTE_WRITE_FLAG=web.enable-remote-write-receiver\nPROMETHEUS_WEB_CONFIG=./prometheus-web.yml\nPROMETHEUS_BASIC_AUTH=echo-otel:%s\nPROMETHEUS_BASIC_AUTH_PASSWORD=%s' "$PROMETHEUS_RW_PASSWORD" "$PROMETHEUS_RW_PASSWORD")
  log "Prometheus remote write 수신 켬 (basic auth 사용자 echo-otel)"
fi

# 4. .env = 비밀값 + Terraform 이 정한 값 (매 부팅 다시 쓴다)
umask 077
{
  grep -v '^PROMETHEUS_RW_PASSWORD=' "$ROOT/.env.secrets"
  cat <<ECHO_ENV_EOF
UPSTREAMS=${upstreams}
DEFAULT_WEIGHTS=${default_weights}
SYNC_FROM=${sync_from}
ECHO_ENV_EOF
  printf '%s\n' "$PROM_ENV"
} > "$ROOT/.env"
umask 022

# 5. 올리기
cd "$ROOT"
docker compose up -d --build --remove-orphans
log "완료: http://$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip)/__entry/healthz"
