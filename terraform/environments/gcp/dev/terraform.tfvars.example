# 복사해서 terraform.tfvars 로 쓴다 (terraform.tfvars 는 커밋하지 않는다).
project_id = "<gcp-project-id>"

gke_admin_members = [
  "user:<팀원 구글 계정>",
]

# 장소 IP 가 정해지면 좁힌다
# gke_public_access_cidrs = ["203.0.113.0/24"]

# 가중치·요약 API(8080)와 Prometheus·Grafana 를 열 출발 IP: echo-was 가 있는 클러스터의 NAT IP (GKE nat_ip, 임시로 AWS NAT EIP)
# entrypoint_admin_cidrs = ["<gke nat_ip>/32", "<aws nat eip>/32"]
# 인프라 9 OTel: 진입점 Prometheus remote write 수신 + basic auth (기본 false = 지금과 같음)
# entrypoint_prometheus_remote_write = true
# entrypoint_remote_write_cidrs      = ["<온프레 EC2 공인 IP>/32"]   # 9090 만 연다

# 결제 계정 관리자만 만들 수 있다. 아니면 비워 두고 콘솔 예산을 쓴다.
# billing_account            = "XXXXXX-XXXXXX-XXXXXX"
# budget_limit_usd           = 150
# budget_notification_emails = ["<팀 메일>"]

# 진입점 업스트림 = 환경별 데모앱 주소 (demo-app/README.md). 비우면 placeholder 라 503 만 난다.
# entrypoint_upstreams = {
#   aws = "<EKS demo-app NLB DNS>:80"
#   gcp = "<GKE demo-app 내부 LB IP>:80"
# }
