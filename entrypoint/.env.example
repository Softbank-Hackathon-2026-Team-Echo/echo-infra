# 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다). VM 에서는 startup 스크립트가 만든다.
WEIGHTS_TOKEN=<openssl rand -hex 32>
GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 16>

# 환경별 업스트림 (순서 = 환경 순서). AWS ALB 주소, GKE 인그레스 주소.
UPSTREAMS=aws=placeholder.invalid:80,gcp=placeholder.invalid:80
DEFAULT_WEIGHTS=aws=100,gcp=0

# 호스트 포트 (로컬에서 80 이 막혀 있으면 바꾼다)
ENTRY_HTTP_PORT=80
WEIGHTS_API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
