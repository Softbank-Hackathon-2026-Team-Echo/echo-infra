# 복사해서 .env 로 쓴다 (.env 는 커밋하지 않는다). VM 에서는 startup 스크립트가 만든다.
WEIGHTS_TOKEN=<openssl rand -hex 32>
GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 16>

# 환경별 업스트림 (순서 = 환경 순서). AWS ALB 주소, GKE 인그레스 주소.
UPSTREAMS=aws=placeholder.invalid:80,gcp=placeholder.invalid:80
DEFAULT_WEIGHTS=aws=100,gcp=0

# 인프라 9: Prometheus remote write 수신 + basic auth (기본 꺼짐). 켤 때:
#   printf '%s' "$PW" | bash scripts/render-prometheus-web.sh ./prometheus-web.yml echo-otel
# PROMETHEUS_REMOTE_WRITE_FLAG=web.enable-remote-write-receiver   # 끔 = no-web.enable-remote-write-receiver(기본)
# PROMETHEUS_WEB_CONFIG=./prometheus-web.yml
# PROMETHEUS_BASIC_AUTH=echo-otel:<비밀번호>
# PROMETHEUS_BASIC_AUTH_PASSWORD=<비밀번호>

# 인프라 12.4: 요청 기록(journal). 기본 꺼짐. Envoy 필터는 따로 runtime_modify?journal.enabled=100 으로 켠다(README "요청 기록")
# JOURNAL_ENABLED=true
# JOURNAL_TOKEN=<openssl rand -hex 32>

# 호스트 포트 (로컬에서 80 이 막혀 있으면 바꾼다)
ENTRY_HTTP_PORT=80
WEIGHTS_API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JOURNAL_ADMIN_PORT=8082
